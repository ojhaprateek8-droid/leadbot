# ---------------------------------------------------------------------------
# CallAudit AI - environment example. Copy to .env.local (dev) or .env (server).
# Never commit real secrets. Privileged provider keys stay server-side only.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# SQLite (default, single-file, easiest to self-host):
DATABASE_URL="file:./dev.db"
# To use PostgreSQL instead: set provider="postgresql" in prisma/schema.prisma
# DATABASE_URL="postgresql://user:pass@localhost:5432/callaudit?schema=public"

# --- Session signing (REQUIRED in production) ------------------------------
# 32+ character random string. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me-to-a-long-random-string-min-32-chars"
# Mark production mode on (enables secure cookies + strict startup checks)
NODE_ENV=development

# --- Private audio storage -------------------------------------------------
# Directory holding uploaded recordings. Must NOT be served publicly.
STORAGE_DIR="./storage"
MAX_UPLOAD_MB=100

# --- AI providers ----------------------------------------------------------
# "mock" runs a deterministic offline pipeline (no API cost) for pilots/dev.
# "openai" uses the transcription + chat APIs below.
STT_PROVIDER=mock
LLM_PROVIDER=mock

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
STT_MODEL=whisper-1
LLM_MODEL=gpt-4o-mini
# Rough pricing (USD per unit) used only for cost logging estimates.
EST_COST_PER_AUDIO_MINUTE_USD=0.006
EST_COST_PER_1K_INPUT_TOKENS_USD=0.15
EST_COST_PER_1K_OUTPUT_TOKENS_USD=0.6

# --- Worker ----------------------------------------------------------------
WORKER_ENABLED=true
WORKER_POLL_INTERVAL_MS=5000
JOB_MAX_ATTEMPTS=3
LOW_CONFIDENCE_THRESHOLD=0.7

# --- Rate limiting / quotas ------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=240

# --- Bootstrap admin (used by first-run setup) -----------------------------
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=
BOOTSTRAP_ORG_NAME=
